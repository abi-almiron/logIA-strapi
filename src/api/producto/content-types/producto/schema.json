{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Producto",
    "description": "Producto del inventario"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "codigo": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "nombre": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "text"
    },
    "precio": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "stock": {
      "type": "decimal",
      "required": true,
      "default": 0,
      "min": 0
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
